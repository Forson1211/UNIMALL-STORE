MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=unimall
# Optional, for networks whose system DNS cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
PORT=4000
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
TRUST_PROXY=false
REQUIRE_EMAIL_VERIFICATION=false
# Required for password recovery, and when email verification is enabled.
SMTP_URL=
MAIL_FROM=
# Initial administrator used by npm run db:seed. Existing accounts keep their password.
SEED_ADMIN_EMAIL=
# Leave empty to generate a password into an ignored local credentials file.
SEED_ADMIN_PASSWORD=

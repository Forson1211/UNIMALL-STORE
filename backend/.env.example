MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=unimall
# Optional, for networks whose system DNS cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
PORT=4000
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
TRUST_PROXY=false
REQUIRE_EMAIL_VERIFICATION=false
# Required for password recovery, and when email verification is enabled.
SMTP_URL=
MAIL_FROM=
# Initial administrator used by npm run db:seed. Existing accounts keep their password.
SEED_ADMIN_EMAIL=
# Leave empty to generate a password into an ignored local credentials file.
SEED_ADMIN_PASSWORD=

# Online finance starts disabled. Use test keys first; never put secrets in VITE_* variables.
PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false
PAYOUTS_REQUIRE_APPROVAL=true
PAYSTACK_TEST_MODE=true
PAYSTACK_SECRET_KEY=
PAYSTACK_INTEGRATION_ID=
# Enable only channels verified for your Ghana merchant account.
PAYSTACK_CHANNELS=card
PAYMENT_CHANNELS_VERIFIED=false
PAYSTACK_BUSINESS_VERIFIED=false
PAYSTACK_TRANSFERS_VERIFIED=false
ESCROW_OR_DELAYED_SETTLEMENT_APPROVED=false
# 32 random bytes encoded as 64 hex characters; keep backed up separately from MongoDB.
PAYOUT_ENCRYPTION_KEY=
# Long random bearer credential for POST /api/internal/finance/run.
FINANCE_CRON_SECRET=
CHECKOUT_EXPIRY_MINUTES=30
PLATFORM_COMMISSION_BPS=500
PAYOUT_MINIMUM_PESEWAS=2000
PAYOUT_WAITING_HOURS=48
COD_ENABLED=true
